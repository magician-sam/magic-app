{
  "name": "magic-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "npm run build && npm start",
    "setup": "npm run build && node --env-file-if-exists=.env dist/setup.js",
    "backup": "node --env-file-if-exists=.env dist/backup.js",
    "restore": "node --env-file-if-exists=.env dist/restore.js",
    "test:drivers": "npm run build && node scripts/test-drivers.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}

